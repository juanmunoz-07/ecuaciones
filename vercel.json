{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "extra.css", "use": "@vercel/static" },
    { "src": "script.js", "use": "@vercel/static" },
    { "src": "engine.js", "use": "@vercel/static" },
    { "src": "extra.js", "use": "@vercel/static" },
    { "src": "api/chat.js", "use": "@vercel/node", "config": { "includeFiles": ["prompt.txt"] } }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/api/chat.js" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.html" }
  ]
}
